{
  "name": "vscode-base",
  "displayName": "VSCode Base (credwards27)",
  "description": "Base shared configuration extension for VSCode.",
  "version": "0.0.2",
  "author": {
    "name": "credwards27"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/credwards27/vscode-base.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.103.0"
  },
  "scripts": {
    "compile-package": "node compile-package.js",
    "update": "git checkout main && git pull",
    "clean": "if [ -d \"dist\" ]; then rm dist/*.vsix; fi",
    "build": "mkdir -p dist && npx @vscode/vsce package --out dist",
    "install": "code --install-extension \"dist/${npm_package_name}-${npm_package_version}\".vsix",
    "upgrade": "npm run clean && npm run build && npm run install"
  },
  "categories": [
    "Keymaps",
    "Snippets",
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Slate",
        "uiTheme": "vs-dark",
        "path": "./themes/Slate.json"
      }
    ],
    "keybindings": [
      {
        "key": "shift+cmd+f",
        "command": "editor.action.startFindReplaceAction",
        "when": "editorFocus || editorIsOpen"
      },
      {
        "key": "alt+cmd+f",
        "command": "workbench.action.findInFiles",
        "when": "!isSessionsWindow"
      },
      {
        "key": "cmd+k cmd+u",
        "command": "editor.action.transformToUppercase"
      },
      {
        "key": "cmd+k cmd+l",
        "command": "editor.action.transformToLowercase"
      },
      {
        "key": "cmd+k",
        "command": "workbench.action.terminal.clear",
        "when": "terminalFocus"
      },
      {
        "key": "cmd+shift+v",
        "command": "pasteAndIndent.action",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  }
}
