    "Bash script template": {
        "prefix": "///bash",
        "scope": "shellscript",
        "body": [
            "#!/bin/bash",
            "",
            "function main() {",
            "\t#",
            "\t# Get arguments",
            "\t#",
            "\t",
            "\tlocal args=( \"\\$@\" ) \\",
            "\t\tflag_arg value_arg key",
            "\t",
            "\tfor arg in \"\\${args[@]}\"; do",
            "\t\tkey=\"\\$1\"",
            "\t\t",
            "\t\tcase \\$key in",
            "\t\t\t# Flag",
            "\t\t\t-f|--flag)",
            "\t\t\tflag_arg=1",
            "\t\t\t;;",
            "\t\t\t",
            "\t\t\t# Key value pair",
            "\t\t\t-a|--arg)",
            "\t\t\targ_name=\"\\$2\"",
            "\t\t\tshift",
            "\t\t\t;;",
            "\t\t\t",
            "\t\t\t# Show help message",
            "\t\t\t--help)",
            "\t\t\tshowHelp",
            "\t\t\treturn 0",
            "\t\t\t;;",
            "\t\t\t",
            "\t\t\t# Implicit ordered argument",
            "\t\t\t*)",
            "\t\t\t;;",
            "\t\tesac",
            "\t\t",
            "\t\t# Shift to next argument",
            "\t\tshift",
            "\tdone",
            "}",
            "",
            "function showHelp() {",
            "\tlocal concise=\\$1 \\",
            "\t\tbold=\\$(tput bold) \\",
            "\t\tnormal=\\$(tput sgr0) \\",
            "\t\thelp_msg",
            "\t",
            "\t# Concise form, used for alerting the user that help exists",
            "\tif [[ -n \\$concise ]]; then",
            "\t\tprintf \"Type '${1:script-command} --help' for more information\\n\"",
            "\t\treturn 0",
            "\tfi",
            "\t",
            "\tread -rd '' help_msg <<EOF",
            "${1/(.+)/\\U$1/g}(1)                       ${2:Proper Script Name} Manual                       ${1/(.+)/\\U$1/g}(1)",
            "",
            "\\${bold}NAME\\${normal}",
            "\t${1} - ${3:Brief summary of script}",
            "",
            "\\${bold}SYNOPSIS\\${normal}",
            "\t${1} [-a|--arg <value>] [-f|--flag] [--help] <implicit ordered arg>",
            "",
            "\\${bold}DESCRIPTION\\${normal}",
            "\t${4:Full description of script.}",
            "",
            "\\${bold}OPTIONS\\${normal}",
            "\t-a|--arg <value>",
            "\t\tExplanation of argument.",
            "\t",
            "\t-f|--flag",
            "\t\tExplanation of flag",
            "\t",
            "\t--help",
            "\t\tDisplays this help information.",
            "",
            "\\${bold}BASIC USAGE\\${normal}",
            "\t${1} --arg \"example value\" -f",
            "\t\tDescription of this use case.",
            "",
            "\\${bold}AUTHOR\\${normal}",
            "\t${5:Author Name} <${6:author email or handle}>",
            "",
            "\\${bold}LICENSE (ISC)\\${normal}",
            "\tCopyright (c) ${10} ${5:Author Name} <${6:author email or handle}>",
            "",
            "\tPermission to use, copy, modify, and/or distribute this software for any",
            "\tpurpose with or without fee is hereby granted, provided that the above",
            "\tcopyright notice and this permission notice appear in all copies.",
            "",
            "\tTHE SOFTWARE IS PROVIDED \"AS IS\" AND THE AUTHOR DISCLAIMS ALL WARRANTIES",
            "\tWITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF",
            "\tMERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY",
            "\tSPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES",
            "\tWHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION",
            "\tOF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN",
            "\tCONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.",
            "",
            "${2} ${7:1.0.0}                       ${8:MM}/${9:DD}/${10:YYYY}                        ${1/(.+)/\\U$1/g}(1)",
            "EOF",
            "\t",
            "\tprintf \"\\$help_msg\\n\" | less -R",
            "}",
            "",
            "main \"\\$@\""
        ],
        "description": "Bash script template"
    },
