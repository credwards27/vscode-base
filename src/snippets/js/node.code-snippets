    "Node __filename polyfill for ES6 modules (don't forget `import { fileURLToPath } from 'node:url';`)": {
        "prefix": "///filename",
        "scope": "javascript,typescript",
        "body": [
            "// ES6 module __filename.",
            "${1:const }__filename = fileURLToPath(import.meta.url),"
        ],
        "description": "Node __filename polyfill for ES6 modules (don't forget `import { fileURLToPath } from 'node:url';`)"
    },
    
    "Node __dirname polyfill for ES6 modules (don't forget `import { fileURLToPath } from 'node:url';` and import path from 'node:path';)": {
        "prefix": "///dirname",
        "scope": "javascript,typescript",
        "body": [
            "// ES6 module __dirname.",
            "${1:const }__dirname = path.dirname(${2:fileURLToPath(import.meta.url)}),"
        ],
        "description": "Node __dirname polyfill for ES6 modules (don't forget `import { fileURLToPath } from 'node:url';` and import path from 'node:path';)"
