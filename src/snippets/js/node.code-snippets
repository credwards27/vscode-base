            "process.exit(${1});"
        ],
        "description": "Node process.exit() call"
    },
    
    "Node CLI script boilerplate": {
        "prefix": "///nodecli",
        "scope": "javascript,typescript",
        "body": [
            "#!/usr/bin/env node",
            "",
            "///jsh${1}${0}",
            "'use strict';",
            "",
            "// Dependencies.",
            "const minimist = require('minimist'),",
            "\tminimistOpts = require('minimist-options'),",
            "\tfs = require('fs'),",
            "\t",
            "\t// Script parameter options.",
            "\tARG_OPTS = {",
            "\t\thelp: {",
            "\t\t\ttype: 'boolean'",
            "\t\t}",
            "\t},",
            "\t",
            "\t// Command line arguments.",
            "\tARGS = Object.freeze(",
            "\t\tminimist(process.argv.slice(2), minimistOpts(ARG_OPTS)));",
            "",
            "/* Shows an error message and exits.",
            "\t",
            "\tmsg - Error message to display.",
            "\thelp - True to show the help text in addition to the error, false otherwise.",
            "*/",
            "function showError(msg, help) {",
            "\tconsole.error(msg);",
            "\t",
            "\tif (help) {",
            "\t\tshowHelp();",
            "\t}",
            "\telse {",
            "\t\tprocess.exit();",
            "\t}",
            "}",
            "",
            "/* Shows the help text.",
            "*/",
            "function showHelp() {",
            "\tprocess.exit();",
            "}",
            "",
            "// Main execution entry point",
            ";(function(undefined) {",
            "\tif (ARGS['help']) {",
            "\t\tshowHelp();",
            "\t}",
            "})(void 0);"
        ],
        "description": "Node CLI script boilerplate"
    }
}
